{
  "name": "@dr-co/dsh-websearch",
  "version": "0.3.0",
  "description": "Web search aggregator for DeepSeek Harness: several providers, one ordered list, per-capability permissions",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-web": "^0.2.1-rc.4",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
